@inherits MSGComponentBase

@if (this.Entry.Result.BothCompleted)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        @* Until the batch is over, nothing on this screen may say which model wrote which answer: no name, no time. A small model is usually faster, so a time would give the model away. *@
        <MudText Typo="Typo.h5" Class="mb-3">
            @this.Heading
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-3">
            @TA("You do not know which model wrote which answer, and the columns are in random order. Compare them by what they say. You learn the names at the end.")
        </MudText>

        @* From the breakpoint md on, both cards stand in the same row, which keeps them equally high, and the question
           with its buttons follows below: the button of each answer under its column, the tie between them. In a
           narrower window, the question comes first, and each answer is followed by its own button, with a line
           between the two answers. The order classes arrange both from the same markup. *@
        <MudGrid Spacing="3">
            <MudItem xs="12" Class="order-0 order-md-3">
                <MudText Typo="Typo.h6">
                    @T("Which answer is better?")
                </MudText>
            </MudItem>

            <ModelComparisonAnswerCard Title="@T("Answer A")" Answer="@this.Entry.PresentationOrder.InColumnA(this.Entry.Result)" Time="@this.Entry.Result.Time" ItemClass="order-1 order-md-1"/>
            <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-start order-2 order-md-4">
                <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.COLUMN_A))">
                    @T("Answer A is better")
                </MudButton>
            </MudItem>

            <MudItem xs="12" Class="d-md-none order-3">
                <MudDivider/>
            </MudItem>

            <ModelComparisonAnswerCard Title="@T("Answer B")" Answer="@this.Entry.PresentationOrder.InColumnB(this.Entry.Result)" Time="@this.Entry.Result.Time" ItemClass="order-4 order-md-2"/>
            <MudItem xs="12" md="4" Class="d-flex justify-center justify-md-end order-5 order-md-6">
                <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.COLUMN_B))">
                    @T("Answer B is better")
                </MudButton>
            </MudItem>

            <MudItem xs="12" md="4" Class="d-flex justify-center order-6 order-md-5">
                <MudButton Variant="Variant.Outlined" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.TIE))">
                    @T("Both are equally good")
                </MudButton>
            </MudItem>

            @if (this.Batch.RunCount > 1)
            {
                <MudItem xs="12" Class="d-flex justify-center order-7 order-md-7">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" Spacing="2">
                        <MudButton Variant="Variant.Text" OnClick="@(() => this.SkipThisRun.InvokeAsync())">
                            @T("Skip this run")
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="@(() => this.SkipRemainingVotes.InvokeAsync())">
                            @T("Skip remaining votes")
                        </MudButton>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.body1" Class="mb-3">
            @T("At least one of the models did not answer in this run, so there is nothing to compare.")
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.NEXT" OnClick="@(() => this.NextEntry.InvokeAsync())">
            @(this.Batch.IsLastEntry ? T("Finish") : T("Next run"))
        </MudButton>
    </MudPaper>
}