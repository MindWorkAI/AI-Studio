@inherits MSGComponentBase

@if (this.Entry.Result.BothCompleted)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        @* Until the batch is over, nothing on this screen may say which model wrote which answer: no name, no time. A small model is usually faster, so a time would give the model away. *@
        <MudText Typo="Typo.h5" Class="mb-3">
            @this.Heading
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-3">
            @TA("You do not know which model wrote which answer, and the columns are in random order. Compare them by what they say. You learn the names at the end.")
        </MudText>

        @* Two columns in every width, and the two cards in the same row: that is what keeps them equally high. *@
        <MudGrid Class="mb-3" Spacing="3">
            <ModelComparisonAnswerCard Title="@T("Answer A")" Answer="@this.Entry.PresentationOrder.InColumnA(this.Entry.Result)" Time="@this.Entry.Result.Time"/>
            <ModelComparisonAnswerCard Title="@T("Answer B")" Answer="@this.Entry.PresentationOrder.InColumnB(this.Entry.Result)" Time="@this.Entry.Result.Time"/>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mb-2">
            @T("Which answer is better?")
        </MudText>

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.COLUMN_A))">
                @T("Answer A is better")
            </MudButton>
            <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.COLUMN_B))">
                @T("Answer B is better")
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => this.Vote.InvokeAsync(ModelComparisonVote.TIE))">
                @T("Both are equally good")
            </MudButton>
            @if (this.Batch.RunCount > 1)
            {
                <MudButton Variant="Variant.Text" OnClick="@(() => this.SkipThisRun.InvokeAsync())">
                    @T("Skip this run")
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => this.SkipRemainingVotes.InvokeAsync())">
                    @T("Skip remaining votes")
                </MudButton>
            }
        </MudStack>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.body1" Class="mb-3">
            @T("At least one of the models did not answer in this run, so there is nothing to compare.")
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.NEXT" OnClick="@(() => this.NextEntry.InvokeAsync())">
            @(this.Batch.IsLastEntry ? T("Finish") : T("Next run"))
        </MudButton>
    </MudPaper>
}