@using AIStudio.Chat
@inherits MSGComponentBase

<MudItem xs="6" Class="d-flex flex-column">
    <MudText Typo="Typo.subtitle1">
        @this.Title
    </MudText>
    @if (this.Answer.Completed)
    {
        <ContentBlockComponent Role="ChatRole.AI" Type="ContentType.TEXT" Time="@this.Time" Content="@this.content" Class="@this.CardClass"/>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="@this.CardClass">
            @T("This model did not answer.")
        </MudAlert>
    }
</MudItem>