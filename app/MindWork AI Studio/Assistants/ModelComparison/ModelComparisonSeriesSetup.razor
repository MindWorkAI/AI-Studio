@inherits MSGComponentBase

<MudPaper Outlined="true" Class="pa-4 mb-4 mr-3">
    <MudText Typo="Typo.h5" Class="mb-2">
        @T("New comparison series")
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        @TA("Both models work with the same profile, the same tools, and the same data sources. AI Studio offers only what both models may use. You will not learn which model answers in which chat until you look at the result of the series.")
    </MudText>

    <MudTextField T="string" @bind-Value="@this.seriesName" Label="@T("Name of the series")" Placeholder="@T("e.g., Weekly reports")" Variant="Variant.Outlined" Class="mb-3"/>

    <div class="border-dashed border rounded-lg pa-3 mb-3">
        <MudText Typo="Typo.subtitle1" Class="mb-1">@T("First model")</MudText>
        <ProviderSelection ProviderSettings="@this.firstProvider" ProviderSettingsChanged="@this.FirstProviderChanged"/>
        <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">@T("Second model")</MudText>
        <ProviderSelection ProviderSettings="@this.secondProvider" ProviderSettingsChanged="@this.SecondProviderChanged"/>
    </div>

    <div class="border-dashed border rounded-lg pa-3 mb-3">
        <MudSwitch T="bool" Value="@this.judgeEnabled" ValueChanged="@this.JudgeEnabledChanged" Color="Color.Primary" Label="@T("Judge (optional)")"/>
        <MudText Typo="Typo.body2" Class="mb-2">
            @TA("After your own vote, a third model compares both chats of a task and gives its own verdict. It never learns which model wrote which chat.")
        </MudText>
        @if (this.judgeEnabled)
        {
            <ProviderSelection ProviderSettings="@this.judgeProvider" ProviderSettingsChanged="@this.JudgeProviderChanged"/>
        }
    </div>

    <ProfileSelection CurrentProfile="@this.profile" CurrentProfileChanged="@this.ProfileChanged" MarginLeft=""/>

    @if (this.BothModelsChosen)
    {
        <MudSelect T="string"
                   MultiSelection="true"
                   SelectedValues="@this.selectedToolIds"
                   SelectedValuesChanged="@this.ToolsChanged"
                   ToStringFunc="@this.ToolName"
                   Label="@T("Tools")"
                   HelperText="@this.ToolsHelperText"
                   Disabled="@(this.offeredTools.Count == 0)"
                   Variant="Variant.Outlined"
                   Class="mt-3">
            @foreach (var tool in this.offeredTools)
            {
                <MudSelectItem T="string" Value="@tool.Id">@tool.DisplayName</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   MultiSelection="true"
                   SelectedValues="@this.selectedDataSourceIds"
                   SelectedValuesChanged="@this.DataSourcesChanged"
                   ToStringFunc="@this.DataSourceName"
                   Label="@T("Data sources")"
                   HelperText="@this.DataSourcesHelperText"
                   Disabled="@(this.offeredDataSources.Count == 0)"
                   Variant="Variant.Outlined"
                   Class="mt-3">
            @foreach (var dataSource in this.offeredDataSources)
            {
                <MudSelectItem T="string" Value="@dataSource.Id">@dataSource.Name</MudSelectItem>
            }
        </MudSelect>
    }

    @if (this.issue is { } shownIssue)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">@shownIssue</MudAlert>
    }

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.ADD" OnClick="@this.CreateAsync" Disabled="@this.isSaving">
            @T("Create series")
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="@this.CancelAsync" Disabled="@this.isSaving">
            @T("Cancel")
        </MudButton>
    </MudStack>
</MudPaper>