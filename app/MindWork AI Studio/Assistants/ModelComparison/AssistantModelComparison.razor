@attribute [Route(Routes.ASSISTANT_MODEL_COMPARISON)]
@inherits AssistantBaseCore<AIStudio.Dialogs.Settings.NoSettingsPanel>
@using AIStudio.Chat

@* Two views: the form to fill in, and the batch in short while it runs and once it has. *@
@if (!this.ShowsBatch)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        @* Only the icon button toggles, the same as everywhere else in the app a header collapses a section: the rest of the row is decorative, not a second, redundant click target. Save as new preset stays outside the collapse: capturing the form right now should not need opening this box first. *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
            <MudIcon Icon="@AppIcons.PRESET" Color="Color.Primary"/>
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">
                @T("Presets")
            </MudText>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@AppIcons.SAVE_AS_PRESET" OnClick="@this.SaveAsNewPreset">
                @T("Save as new preset")
            </MudButton>
            <MudIconButton Icon="@(this.presetsSectionExpanded ? AppIcons.EXPAND_LESS : AppIcons.EXPAND_MORE)" Size="Size.Small" OnClick="@(() => this.presetsSectionExpanded = !this.presetsSectionExpanded)" title="@(this.presetsSectionExpanded ? T("Collapse") : T("Expand"))"/>
        </MudStack>

        <MudCollapse Expanded="@this.presetsSectionExpanded">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudSelect T="Guid?" Value="@this.selectedPresetId" ValueChanged="@this.LoadPreset" Label="@T("Load a saved preset")" Variant="Variant.Outlined" Clearable="true" Margin="Margin.Dense">
                        @foreach (var preset in this.presets)
                        {
                            <MudSelectItem T="Guid?" Value="@preset.Id">@preset.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Wrap="Wrap.Wrap">
                        @if (this.SelectedPreset is not null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.SAVE" OnClick="@this.UpdateSelectedPreset">
                                @T("Update preset")
                            </MudButton>
                            <MudIconButton Icon="@AppIcons.DELETE" OnClick="@this.DeletePreset" title="@T("Delete this preset")"/>
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>

            @if (this.SelectedPreset is not null)
            {
                <MudTextField T="string" @bind-Text="@this.presetName" OnBlur="@this.PresetNameWasChanged" Label="@T("Preset name")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"/>
            }
        </MudCollapse>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@AppIcons.MODEL" Color="Color.Primary"/>
            <MudText Typo="Typo.subtitle1">
                @T("Setup")
            </MudText>
        </MudStack>

        <MudGrid Spacing="3" Class="mb-3">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Class="mb-1">
                    @T("First model")
                </MudText>
                <ProviderSelection @bind-ProviderSettings="@this.ProviderSettings" ValidateProvider="@this.ValidatingComparedProvider"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.subtitle2" Class="mb-1">
                    @T("Second model")
                </MudText>
                <ProviderSelection @bind-ProviderSettings="@this.secondProvider" ValidateProvider="@this.ValidatingComparedProvider"/>
            </MudItem>
        </MudGrid>

        <MudSelect T="int" @bind-Value="@this.runCount" Label="@T("Number of runs")" HelperText="@TA("Repeat the same comparison several times to see how consistently the models and the judge come out the same way. You vote blindly on every run.")" Variant="Variant.Outlined">
            <MudSelectItem Value="1">@T("1 (single comparison)")</MudSelectItem>
            <MudSelectItem Value="3">3</MudSelectItem>
            <MudSelectItem Value="5">5</MudSelectItem>
            <MudSelectItem Value="10">10</MudSelectItem>
            <MudSelectItem Value="15">15</MudSelectItem>
            <MudSelectItem Value="20">@T("20 (heavy load on the models)")</MudSelectItem>
        </MudSelect>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
            <MudIcon Icon="@AppIcons.PROMPT" Color="Color.Primary"/>
            <MudText Typo="Typo.subtitle1">
                @TA("Your request")
            </MudText>
        </MudStack>

        <ReadFileContent Text="@T("Load the context from file")" @bind-FileContent="@this.inputContext" EnableDragDrop="true" CatchAllDocuments="true"/>
        <MudTextField T="string" @bind-Text="@this.inputContext" AdornmentIcon="@AppIcons.INPUT_TEXT" Adornment="Adornment.Start" Label="@T("Context (optional)")" HelperText="@TA("Both models receive this text together with your question, for example the document they are supposed to summarize.")" Variant="Variant.Outlined" Lines="6" Sizing="InputSizing.Auto" MaxLines="24" Class="mb-3 mt-3" UserAttributes="@USER_INPUT_ATTRIBUTES"/>
        <MudTextField T="string" @bind-Text="@this.inputQuestion" Validation="@this.ValidatingQuestion" AdornmentIcon="@AppIcons.QUESTIONS" Adornment="Adornment.Start" Label="@TA("Your question or task")" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" MaxLines="12" UserAttributes="@USER_INPUT_ATTRIBUTES"/>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudSwitch T="bool" @bind-Value="@this.judgeEnabled" Color="Color.Primary">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@AppIcons.JUDGE" Color="Color.Primary"/>
                <MudText Typo="Typo.subtitle1">
                    @T("Judge (optional)")
                </MudText>
            </MudStack>
        </MudSwitch>

        @if (this.judgeEnabled)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">
                @T("Judge model")
            </MudText>
            <ProviderSelection @bind-ProviderSettings="@this.judgeProvider" ValidateProvider="@this.ValidatingJudgeProvider"/>

            <MudTextField T="string" @bind-Text="@this.judgeInstructions" AdornmentIcon="@AppIcons.JUDGE" Adornment="Adornment.Start" Label="@T("What should the judge pay particular attention to? (optional)")" HelperText="@TA("The judge already sees the request and both answers and judges by them alone, unless you add something more specific here, for example: a good summary keeps every number and names its source. The judge never learns which model wrote which answer, and you see its verdicts only at the end.")" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" MaxLines="12" Class="mt-3"/>
        }
    </MudPaper>
}
else
{
    @* What was asked, in short: without it, the answers below would have to be judged from memory. *@
    var request = this.CurrentRequest;
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
            <MudIcon Icon="@AppIcons.PROMPT" Color="Color.Primary"/>
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">
                @TA("Your request")
            </MudText>
            <MudIconButton Icon="@(this.requestSummaryExpanded ? AppIcons.EXPAND_LESS : AppIcons.EXPAND_MORE)" Size="Size.Small" OnClick="@(() => this.requestSummaryExpanded = !this.requestSummaryExpanded)" title="@(this.requestSummaryExpanded ? T("Collapse") : T("Expand"))"/>
        </MudStack>

        <MudCollapse Expanded="@this.requestSummaryExpanded">
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;" Class="mb-1 mt-1">
                @request.GetQuestionPreview(QUESTION_PREVIEW_LENGTH)
            </MudText>
            @if (request.Context.Length > 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mb-1">
                    @string.Format(DisplayCulture, T("Context: {0} characters"), request.Context.Length.CompactCount())
                </MudText>
            }
        </MudCollapse>

        @if (this.batch is { RunCount: > 1 } shownBatch)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">
                @T("Progress of the runs")
            </MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-1">
                @for (var i = 0; i < shownBatch.RunCount; i++)
                {
                    var index = i;
                    var status = shownBatch.StatusOf(index);
                    @* A native title attribute, not MudTooltip: while the batch is still running, this row re-renders often enough that MudTooltip's JS-side hover tracking kept losing track of which badge is which, and stopped showing anything at all. A native tooltip lives entirely in the browser, so re-rendering the content underneath it cannot break it. *@
                    @* The current entry gets a ring around its avatar: with several runs done and unvoted, position alone -- second from the left, say -- is too easy to lose track of. *@
                    <MudStack @key="index" Row="false" Spacing="0" AlignItems="AlignItems.Center" title="@this.DescribeRunStatus(shownBatch, index)">
                        <MudBadge Icon="@AppIcons.JUDGE" Color="Color.Tertiary" Overlap="true" Visible="@(this.judgeEnabled && shownBatch.HasJudgeVerdict(index))">
                            <MudAvatar Size="Size.Medium" Color="@(status is ModelComparisonRunStatus.QUEUED or ModelComparisonRunStatus.RUNNING ? Color.Default : Color.Primary)" Variant="@(status is ModelComparisonRunStatus.VOTED ? Variant.Filled : Variant.Outlined)"
                                       Style="@(index == shownBatch.CurrentIndex ? "outline: 2px solid var(--mud-palette-primary); outline-offset: 2px;" : null)">
                                @switch (status)
                                {
                                    case ModelComparisonRunStatus.VOTED:
                                        <MudIcon Icon="@AppIcons.VOTED"/>
                                        break;

                                    case ModelComparisonRunStatus.RUNNING:
                                        @* Only the runs actually in flight get the spinner -- the ones still queued behind the concurrency limit get an hourglass instead: *@
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary"/>
                                        break;

                                    case ModelComparisonRunStatus.QUEUED:
                                        <MudIcon Icon="@AppIcons.PENDING" Style="opacity: 0.5;"/>
                                        break;

                                    case ModelComparisonRunStatus.NO_USABLE_ANSWER or ModelComparisonRunStatus.VOTE_SKIPPED:
                                        <MudIcon Icon="@AppIcons.RUN_WITHOUT_VOTE"/>
                                        break;

                                    default:
                                        <MudIcon Icon="@AppIcons.VOTE_MISSING"/>
                                        break;
                                }
                            </MudAvatar>
                        </MudBadge>
                        <MudText Typo="Typo.caption" Class="mt-1">
                            @(index + 1)
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        }
    </MudPaper>
}

@code {

    private protected override RenderFragment HeaderActions => @<MudTooltip Text="@T("Results of all comparisons")">
        <MudIconButton Variant="Variant.Text" Icon="@AppIcons.COMPARISON_RESULTS" OnClick="@this.OpenResultsDialog"/>
    </MudTooltip>;

    /// <summary>
    /// The card of one answer, with its title above.
    /// </summary>
    /// <remarks>
    /// The same markup for both, so that nothing but the position tells them apart. The two cards
    /// are in one row of the grid and fill it, so they are equally high however long the answers
    /// are. That is why the names of the models are not part of the card: how long a name is
    /// would make the cards differ.
    /// </remarks>
    /// <param name="title">"Answer A" or "Answer B" while the user votes, "First model" or "Second model" in the summary.</param>
    /// <param name="answer">The answer.</param>
    /// <param name="time">When the run ended. Both answers of a run show this one time: a time of their own would tell the faster model from the slower one.</param>
    /// <param name="cardClass">The classes of the card, see AnswerCardClass.</param>
    private RenderFragment AnswerCard(string title, ModelComparisonAnswer answer, DateTimeOffset time, string cardClass) => @<MudItem xs="6" Class="d-flex flex-column">
        <MudText Typo="Typo.subtitle1">
            @title
        </MudText>
        @if (answer.Completed)
        {
            <ContentBlockComponent Role="ChatRole.AI" Type="ContentType.TEXT" Time="@time" Content="@this.ShownAnswer(answer)" Class="@cardClass"/>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="@cardClass">
                @T("This model did not answer.")
            </MudAlert>
        }
    </MudItem>;

    /// <summary>
    /// What the summary says about the model of an answer: its name, how the user voted, whether the judge preferred
    /// it, and how long it took.
    /// </summary>
    /// <remarks>
    /// Below the answer, not above it: an answer can be long, and what stands above it is out of
    /// sight by the time it has been read.
    /// </remarks>
    /// <param name="answer">The answer, which knows who wrote it.</param>
    /// <param name="model">The model whose answer this is.</param>
    /// <param name="voteChoice">The model the user preferred in the run, or null without a vote.</param>
    /// <param name="judgeChoice">The model the judge preferred in the run, or null without a usable verdict.</param>
    private RenderFragment AnswerCaption(ModelComparisonAnswer answer, ModelComparisonModelChoice model, ModelComparisonModelChoice? voteChoice, ModelComparisonModelChoice? judgeChoice) => @<MudItem xs="6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            @if (voteChoice is not null)
            {
                <MudIcon Icon="@OutcomeIcon(voteChoice, model)" Color="@OutcomeColor(voteChoice, model)" Size="Size.Small"/>
            }
            <MudText Typo="Typo.body1" Color="@OutcomeColor(voteChoice, model)" Class="font-weight-bold">
                @answer.Label
            </MudText>
            @if (JudgePreferred(judgeChoice, model))
            {
                <MudChip T="string" Icon="@AppIcons.JUDGE" Size="Size.Medium" Variant="Variant.Filled" Color="Color.Tertiary" Class="font-weight-bold">
                    @T("Judge")
                </MudChip>
            }
        </MudStack>
        <MudText Typo="Typo.body2">
            @this.DescribeTimes(answer)
        </MudText>
    </MudItem>;

    /// <summary>
    /// What the judge said about the two answers of a run. Shown only in the summary, so it cannot anchor a vote of the
    /// user.
    /// </summary>
    /// <param name="entry">The run.</param>
    /// <param name="judge">What the judge said, or that it could not be understood.</param>
    /// <param name="voteChoice">The model the user preferred in the run, or null without a vote.</param>
    /// <param name="judgeChoice">The model the judge preferred in the run, or null without a usable verdict.</param>
    private RenderFragment JudgeVerdictCard(ModelComparisonBatchEntry entry, ModelComparisonJudgeVerdict judge, ModelComparisonModelChoice? voteChoice, ModelComparisonModelChoice? judgeChoice) => @<MudPaper Outlined="true" Class="pa-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
            <MudIcon Icon="@AppIcons.JUDGE" Size="Size.Small"/>
            <MudText Typo="Typo.subtitle1">
                @string.Format(DisplayCulture, T("Judge: {0}"), judge.Label)
            </MudText>
        </MudStack>
        @if (judge.Completed)
        {
            <MudText Typo="Typo.body1" Class="mb-1">
                @this.DescribeJudgePreference(entry, judgeChoice, voteChoice)
            </MudText>
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">
                @judge.Reasoning
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2">
                @T("The judge did not give a usable verdict.")
            </MudText>
        }
    </MudPaper>;

    /// <summary>
    /// One run in the summary, with the names of the models: closed, a line with the vote of the user and the choice
    /// of the judge; open, both answers, the outcome, the times, and the verdict of the judge with its reasoning.
    /// </summary>
    /// <remarks>
    /// The answers stand in the order of the models, not in the columns of the vote: the columns were drawn fresh for
    /// every run, and across several runs, only the names say anything.
    /// </remarks>
    /// <param name="finishedBatch">The batch.</param>
    /// <param name="index">The position of the run, zero-based.</param>
    private RenderFragment RunPanel(ModelComparisonBatch finishedBatch, int index)
    {
        var entry = finishedBatch.Entries[index];
        var voteChoice = finishedBatch.VoteChoiceAt(index);
        var judgeChoice = finishedBatch.JudgeChoiceAt(index);

        // A single run is open from the start: there is nothing else to look at.
        return @<MudExpansionPanel Class="border-solid border rounded-lg" Expanded="@(finishedBatch.RunCount == 1)">
            <TitleContent>
                <div class="d-flex align-center">
                    <MudText Typo="Typo.subtitle1">
                        @this.DescribeRun(entry, index, voteChoice)
                    </MudText>
                    <MudSpacer/>
                    @if (judgeChoice is { } choice)
                    {
                        <MudChip T="string" Icon="@AppIcons.JUDGE" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary" Class="mr-2">
                            @this.NameOf(entry, choice)
                        </MudChip>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <MudGrid Class="mb-3" Spacing="3">
                    @this.AnswerCard(T("First model"), entry.Result.First, entry.Result.Time, AnswerCardClass(voteChoice, ModelComparisonModelChoice.FIRST))
                    @this.AnswerCard(T("Second model"), entry.Result.Second, entry.Result.Time, AnswerCardClass(voteChoice, ModelComparisonModelChoice.SECOND))
                    @this.AnswerCaption(entry.Result.First, ModelComparisonModelChoice.FIRST, voteChoice, judgeChoice)
                    @this.AnswerCaption(entry.Result.Second, ModelComparisonModelChoice.SECOND, voteChoice, judgeChoice)
                </MudGrid>

                @if (entry.Result.Judge is { } judge)
                {
                    @this.JudgeVerdictCard(entry, judge, voteChoice, judgeChoice)
                }
            </ChildContent>
        </MudExpansionPanel>;
    }

    /// <summary>
    /// Everything which follows the Compare button: the wait, the answers, the vote, and the summary.
    /// </summary>
    /// <remarks>
    /// Rendered by the base class below its submit row. This is where the button has to stay above
    /// the vote: content of the body would come before it.
    /// </remarks>
    private protected override RenderFragment BelowSubmitContent => @<div>
        @if (this.batch is { SkipsRemainingVotes: true, IsFinished: false })
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3"/>
                <MudText Typo="Typo.body1">
                    @TA("You skipped the remaining votes. The summary follows once the remaining runs are done.")
                </MudText>
            </MudPaper>
        }
        else if (this.isComparing && this.batch is { CurrentEntry: null } waitingBatch)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                @* The same waiting as in the chat: a bar, and lines where the answers will appear. Both columns look alike, so this says nothing about the models. *@
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3"/>

                <MudText Typo="Typo.body1" Class="mb-3">
                    @(waitingBatch.Entries.Count == 0 ? T("Both models are answering. This can take a while.") : T("Waiting for the next run..."))
                </MudText>

                <MudGrid Spacing="3">
                    <MudItem xs="6">
                        <MudText Typo="Typo.subtitle1">
                            @T("Answer A")
                        </MudText>
                        <MudSkeleton Width="30%" Height="42px"/>
                        <MudSkeleton Width="80%"/>
                        <MudSkeleton Width="100%"/>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.subtitle1">
                            @T("Answer B")
                        </MudText>
                        <MudSkeleton Width="30%" Height="42px"/>
                        <MudSkeleton Width="80%"/>
                        <MudSkeleton Width="100%"/>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
        else if (this.batch is { CurrentEntry: { } entry } currentBatch)
        {
            @if (entry.Result.BothCompleted)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4">
                    @* Until the batch is over, nothing on this screen may say which model wrote which answer: no name, no time. A small model is usually faster, so a time would give the model away. *@
                    <MudText Typo="Typo.h5" Class="mb-3">
                        @(currentBatch.RunCount > 1 ? string.Format(DisplayCulture, T("Run {0} of {1}"), currentBatch.CurrentIndex + 1, currentBatch.RunCount) : T("Answers"))
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mb-3">
                        @TA("You do not know which model wrote which answer, and the columns are in random order. Compare them by what they say. You learn the names at the end.")
                    </MudText>

                    @* Two columns in every width, and the two cards in the same row: that is what keeps them equally high. *@
                    <MudGrid Class="mb-3" Spacing="3">
                        @this.AnswerCard(T("Answer A"), entry.PresentationOrder.InColumnA(entry.Result), entry.Result.Time, FILL_THE_COLUMN)
                        @this.AnswerCard(T("Answer B"), entry.PresentationOrder.InColumnB(entry.Result), entry.Result.Time, FILL_THE_COLUMN)
                    </MudGrid>

                    <MudText Typo="Typo.h6" Class="mb-2">
                        @T("Which answer is better?")
                    </MudText>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote(ModelComparisonVote.COLUMN_A))">
                            @T("Answer A is better")
                        </MudButton>
                        <MudButton Variant="Variant.Filled" OnClick="@(() => this.Vote(ModelComparisonVote.COLUMN_B))">
                            @T("Answer B is better")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => this.Vote(ModelComparisonVote.TIE))">
                            @T("Both are equally good")
                        </MudButton>
                        @if (currentBatch.RunCount > 1)
                        {
                            <MudButton Variant="Variant.Text" OnClick="@this.SkipThisRun">
                                @T("Skip this run")
                            </MudButton>
                            <MudButton Variant="Variant.Text" OnClick="@this.SkipRemainingVotes">
                                @T("Skip remaining votes")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4 mb-4">
                    <MudText Typo="Typo.body1" Class="mb-3">
                        @T("At least one of the models did not answer in this run, so there is nothing to compare.")
                    </MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.NEXT" OnClick="@this.GoToNextEntry">
                        @(currentBatch.IsLastEntry ? T("Finish") : T("Next run"))
                    </MudButton>
                </MudPaper>
            }
        }
        else if (this.batch is { IsFinished: true } finishedBatch)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.h5" Class="mb-3">
                    @(finishedBatch.RunCount > 1 ? string.Format(DisplayCulture, T("All {0} runs are done."), finishedBatch.RunCount) : T("Done."))
                </MudText>

                @if (finishedBatch.Entries.Count > 0)
                {
                    var firstLabel = finishedBatch.Entries[0].Result.First.Label;
                    var secondLabel = finishedBatch.Entries[0].Result.Second.Label;
                    var voteTally = finishedBatch.TallyVotes();
                    var judgeTally = this.judgeEnabled ? finishedBatch.TallyJudgeVerdicts() : null;

                    <MudSimpleTable Dense="true" Hover="true" Class="mb-1">
                        <thead>
                            <tr>
                                <th></th>
                                <th>@firstLabel</th>
                                <th>@secondLabel</th>
                                <th>@T("Equally good")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@TA("Your votes")</td>
                                <td>@voteTally.FirstModelWins</td>
                                <td>@voteTally.SecondModelWins</td>
                                <td>@voteTally.Ties</td>
                            </tr>
                            @if (judgeTally is not null)
                            {
                                <tr>
                                    <td>@T("Judge verdicts")</td>
                                    <td>@judgeTally.FirstModelWins</td>
                                    <td>@judgeTally.SecondModelWins</td>
                                    <td>@judgeTally.Ties</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    var votesMissing = voteTally.UnscoredRunCount;
                    var judgeVerdictsMissing = judgeTally?.UnscoredRunCount ?? 0;

                    @if (votesMissing > 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            @string.Format(DisplayCulture, TA("{0} of {1} runs have no vote from you, because you skipped them or a model did not answer. They are not counted above."), votesMissing, voteTally.TotalRunCount)
                        </MudText>
                    }
                    @if (judgeTally is not null && judgeVerdictsMissing > 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block">
                            @string.Format(DisplayCulture, T("{0} of {1} runs have no usable judge verdict. They are not counted above."), judgeVerdictsMissing, judgeTally.TotalRunCount)
                        </MudText>
                    }
                }
            </MudPaper>

            @if (finishedBatch.Entries.Count > 0)
            {
                <MudExpansionPanels MultiExpansion="@true" Class="mb-4">
                    @for (var i = 0; i < finishedBatch.Entries.Count; i++)
                    {
                        @this.RunPanel(finishedBatch, i)
                    }
                </MudExpansionPanels>
            }

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@AppIcons.RESET" OnClick="@this.StartNewBatch">
                    @T("Start a new request")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@AppIcons.COMPARISON_RESULTS" OnClick="@this.OpenResultsDialog">
                    @T("Results of all comparisons")
                </MudButton>
            </MudStack>
        }
    </div>;

}
