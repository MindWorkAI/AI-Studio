@inherits MSGComponentBase

@* A single run is open from the start: there is nothing else to look at. *@
<MudExpansionPanel Class="border-solid border rounded-lg" Expanded="@(this.Batch.RunCount == 1)">
    <TitleContent>
        <div class="d-flex align-center">
            <MudText Typo="Typo.subtitle1">
                @this.Heading
            </MudText>
            <MudSpacer/>
            @if (this.JudgeChoice is { } choice)
            {
                <MudChip T="string" Icon="@AppIcons.JUDGE" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Tertiary" Class="mr-2">
                    @this.NameOf(choice)
                </MudChip>
            }
        </div>
    </TitleContent>
    <ChildContent>
        @* From the breakpoint md on, both cards in one row and both captions in the next; in a narrower window, each
           caption right below its answer, with a line between the two answers. *@
        <MudGrid Class="mb-3" Spacing="3">
            <MudItem xs="12" md="6" Class="d-flex flex-column order-1 order-md-1">
                <ModelComparisonAnswerCard Title="@T("First model")" Answer="@this.Entry.Result.First" Time="@this.Entry.Result.Time" CardClass="@ModelComparisonOutcome.CardClassOf(this.VoteChoice, ModelComparisonModelChoice.FIRST)"/>
            </MudItem>
            <ModelComparisonAnswerCaption Answer="@this.Entry.Result.First" Model="@ModelComparisonModelChoice.FIRST" VoteChoice="@this.VoteChoice" JudgeChoice="@this.JudgeChoice" ItemClass="order-2 order-md-3"/>
            <MudItem xs="12" Class="d-md-none order-3">
                <MudDivider/>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex flex-column order-4 order-md-2">
                <ModelComparisonAnswerCard Title="@T("Second model")" Answer="@this.Entry.Result.Second" Time="@this.Entry.Result.Time" CardClass="@ModelComparisonOutcome.CardClassOf(this.VoteChoice, ModelComparisonModelChoice.SECOND)"/>
            </MudItem>
            <ModelComparisonAnswerCaption Answer="@this.Entry.Result.Second" Model="@ModelComparisonModelChoice.SECOND" VoteChoice="@this.VoteChoice" JudgeChoice="@this.JudgeChoice" ItemClass="order-5 order-md-4"/>
        </MudGrid>

        <ModelComparisonJudgeVerdictCard Result="@this.Entry.Result" VoteChoice="@this.VoteChoice" JudgeChoice="@this.JudgeChoice"/>
    </ChildContent>
</MudExpansionPanel>