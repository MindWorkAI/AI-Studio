@attribute [Route(Routes.ASSISTANT_SWOT_ANALYSIS)]
@inherits AssistantBaseCore<AIStudio.Dialogs.Settings.SettingsDialogSWOTAnalysis>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
    @T("This SWOT analysis cannot be considered complete or reliable because it can only be created based on the uploaded documents. Without appropriate supporting materials, there is no basis for a sound strategic assessment. Therefore, this analysis should be understood as an initial version and will be revised and improved by us as work continues.")
</MudAlert>

@if (!this.SettingsManager.ConfigurationData.SWOTAnalysis.HideWebContentReader)
{
    <ReadWebContent @bind-Content="@this.inputText" ProviderSettings="@this.ProviderSettings" @bind-AgentIsRunning="@this.isAgentRunning" @bind-Preselect="@this.showWebContentReader" @bind-PreselectContentCleanerAgent="@this.useContentCleanerAgent"/>
}
<MudText Typo="Typo.h5" Class="mb-3">
    @T("Input")
</MudText>
<MudTextField T="string" Disabled="@this.isAgentRunning" @bind-Text="@this.inputText" Validation="@this.ValidatingText" AdornmentIcon="@Icons.Material.Filled.DocumentScanner" Adornment="Adornment.Start" Label="@T("Subject of analysis")" Variant="Variant.Outlined" Lines="6" AutoGrow="@true" MaxLines="12" Class="mb-3" UserAttributes="@USER_INPUT_ATTRIBUTES"/>
<ReadFileContent @bind-FileContent="@this.inputText" MediaImportTargetId="swot-analysis-subject" EnableDragDrop="true" CatchAllDocuments="true"/>

<MudText Typo="Typo.h5" Class="mb-3 mt-6">
    @T("Analysis Options")
</MudText>
<MudTextField T="string" Disabled="@this.isAgentRunning" @bind-Text="@this.analysisGoal" Validation="@this.ValidatingAnalysisGoal" AdornmentIcon="@Icons.Material.Filled.TrackChanges" Adornment="Adornment.Start" Label="@T("Analysis goal")" Variant="Variant.Outlined" Lines="4" AutoGrow="@true" Class="mb-3"/>
<ReadFileContent @bind-FileContent="@this.analysisGoal" MediaImportTargetId="swot-analysis-goal" EnableDragDrop="true"/>
<MudTextField T="string" Disabled="@this.isAgentRunning" @bind-Text="@this.importantAspects" AdornmentIcon="@Icons.Material.Filled.List" Adornment="Adornment.Start" Label="@T("(Optional) Analysis focus")" HelperText="@T("Specify topics the SWOT analysis should pay particular attention to.")" Variant="Variant.Outlined" Lines="4" AutoGrow="@true" Class="mb-3"/>
<ReadFileContent @bind-FileContent="@this.importantAspects" MediaImportTargetId="swot-analysis-focus" EnableDragDrop="true"/>

<MudText Typo="Typo.h5" Class="mb-3 mt-6">
    @T("Contextual Knowledge")
</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    @T("To enhance the validity of the SWOT analysis, please upload supplementary documents that provide empirical or contextual data for a comprehensive internal and external assessment.")
</MudText>
<AttachDocuments Name="SWOT Analysis Context Material" @bind-DocumentPaths="@this.contextMaterials" UseSmallForm="false" Provider="@this.ProviderSettings"/>

<div style="margin-top: 20px;">
    <EnumSelection T="CommonLanguages" NameFunc="@(language => language.Name())" @bind-Value="@this.selectedTargetLanguage" Icon="@Icons.Material.Filled.Translate" Label="@T("Target language")" AllowOther="@true" @bind-OtherInput="@this.customTargetLanguage" OtherValue="CommonLanguages.OTHER" LabelOther="@T("Custom target language")" ValidateOther="@this.ValidateCustomLanguage" />
    <ProviderSelection @bind-ProviderSettings="@this.ProviderSettings" ValidateProvider="@this.ValidatingProvider"/>
</div>

@code {
    private protected override RenderFragment? BelowSubmitContent =>
        this.categoryAnalysisProgress.Count > 0 && this.analysisResult is null
            ? @<div class="swot-live-progress" aria-live="polite">
                  <SwotCategoryGrid>
                      <Strengths>
                          @this.RenderCategoryProgress(SwotAnalysisCategory.STRENGTHS, T("Strengths"))
                      </Strengths>
                      <Weaknesses>
                          @this.RenderCategoryProgress(SwotAnalysisCategory.WEAKNESSES, T("Weaknesses"))
                      </Weaknesses>
                      <Opportunities>
                          @this.RenderCategoryProgress(SwotAnalysisCategory.OPPORTUNITIES, T("Opportunities"))
                      </Opportunities>
                      <Threats>
                          @this.RenderCategoryProgress(SwotAnalysisCategory.THREATS, T("Threats"))
                      </Threats>
                  </SwotCategoryGrid>

                  @if (this.isFinalizingAnalysis)
                  {
                      <div class="swot-finalization-status">
                          <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
                          <MudText Typo="Typo.body2">@T("Creating prioritized actions...")</MudText>
                      </div>
                  }
              </div>
            : null;

    private protected override RenderFragment? CustomResultTextContent => this.analysisResult is null
        ? null
        : @<SwotAnalysisResultView Result="@this.analysisResult"/>;

    private RenderFragment RenderCategoryProgress(SwotAnalysisCategory category, string label) => @<text>
        <MudText Typo="Typo.h5" Class="mb-2">@label</MudText>
        @if (!this.categoryAnalysisProgress.TryGetValue(category, out var progress) || progress.Status is SwotCategoryAnalysisStatus.RUNNING)
        {
            <div class="swot-category-status" aria-busy="true">
                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
                <MudText Typo="Typo.body2">@T("Analyzing this category...")</MudText>
            </div>
        }
        else if (progress.Status is SwotCategoryAnalysisStatus.COMPLETED && progress.Result is not null)
        {
            @if (progress.Result.Findings.Count == 0)
            {
                <MudText Typo="Typo.body1">@progress.Result.EmptyMessage</MudText>
            }
            else
            {
                <ul class="swot-live-findings">
                    @foreach (var finding in progress.Result.Findings)
                    {
                        <li>@finding.Summary</li>
                    }
                </ul>
            }
        }
        else
        {
            <MudAlert Severity="@(progress.Status is SwotCategoryAnalysisStatus.FAILED ? Severity.Error : Severity.Warning)" Dense="true">
                @progress.Message
            </MudAlert>
        }
    </text>;
}
