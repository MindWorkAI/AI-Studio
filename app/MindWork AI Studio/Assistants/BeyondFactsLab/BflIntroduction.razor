@inherits MSGComponentBase

<MudText Typo="Typo.subtitle1" Class="mb-2"><b>@T("Reflect. Take a position. Communicate.")</b></MudText>
<MudText Typo="Typo.body1" Class="mb-2">
    @TA("The lab is a tool for reflection and training for researchers and science communicators. It helps you prepare a challenging public appearance, such as a talk, a panel discussion, an interview, or a hearing: not only its content, but also its strategy and its ethics. You clarify your goals and your role, make scientific uncertainties and assumptions about values visible, reflect on framing, and practice critical questions.")
</MudText>
<MudText Typo="Typo.body1" Class="mb-3">
    @T("The knowledge base of the lab is a guide on science in public debates by Lara Wüster from the Technical University of Munich (TUM).")
</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Schedule" Class="mb-4">
    @TA("Plan about 30 to 60 minutes for a preparation. You can pause at any time: AI Studio saves your details and conversations, and you continue where you left off.")
</MudAlert>

<MudText Typo="Typo.h6" Class="mb-1">@T("What the lab does not do")</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    @TA("The lab writes no press releases or other PR texts, and it checks no facts. It replaces neither your own expert review nor the legal and data protection advice of your institution, and it makes no political or normative decision for you. For a quick text, use the chat or another assistant of AI Studio.")
</MudText>

<MudText Typo="Typo.h6">@T("How to proceed")</MudText>
<MudList T="string" ReadOnly="@true" Dense="@true" Class="mb-3">
    <MudListItem T="string" Icon="@Icons.Material.Filled.LooksOne">@TA("Create a preparation for your event with 'New preparation'.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.LooksTwo">@TA("Work through the seven steps, in any order you like. Each step has the form 'Your details' and a conversation of its own.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.Looks3">@TA("Fill in what you know. Fields may stay empty: the lab shows which key details are missing and asks for them in the conversation.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.Looks4">@TA("Let the lab start the conversation of a step, or write first and say what support you want, e.g., with your role, your strategy, or a round of critical questions. You can always say that you do not know.")</MudListItem>
</MudList>

<MudText Typo="Typo.h6">@T("How to recognize good results")</MudText>
<MudList T="string" ReadOnly="@true" Dense="@true" Class="mb-3">
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@TA("The answers refer to your event and your details.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@TA("You can tell evidence, interpretation, assumptions about values, and recommendations apart.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@TA("Uncertainties and the limits of your expertise stay visible.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@T("Counterarguments are presented fairly.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@TA("The strategy fits your real speaking time and focuses on a few key messages.")</MudListItem>
    <MudListItem T="string" Icon="@Icons.Material.Filled.TaskAlt">@TA("You keep the decision about which position you take.")</MudListItem>
</MudList>

<MudText Typo="Typo.body1">
    @TA("Not sure whether the lab fits your task? Ask it in 'Is the lab right for my task?'.")
</MudText>