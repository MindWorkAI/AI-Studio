@inherits SettingsDialogBase

<MudDialog ContentClass="dialog-content-aligned" ActionsClass="dialog-actions-aligned">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2"/>
            @T("Configured Format Templates")
        </MudText>
    </TitleContent>
    <DialogContent>
        <FormatTemplateManagement/>
    </DialogContent>
    <DialogActions>
        @* In the footer, adding and importing stay in reach however long the table grows: *@
        <FormatTemplateAddButtons/>
        <MudSpacer/>
        <MudButton OnClick="@this.Close" Variant="Variant.Filled">
            @T("Close")
        </MudButton>
    </DialogActions>
</MudDialog>