@using AIStudio.Settings
@inherits SettingsDialogBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center">
            <MudIcon Icon="@AppIcons.ASSISTANT_MODEL_COMPARISON" Class="mr-2" />
            @T("Assistant: Model Comparison Options")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-3 mb-8 border-dashed border rounded-lg">
            <ConfigurationOption OptionDescription="@T("Preselect Model Comparison options?")" LabelOn="@T("Model Comparison options are preselected")" LabelOff="@T("No Model Comparison options are preselected")" State="@(() => this.SettingsManager.ConfigurationData.ModelComparison.PreselectOptions)" StateUpdate="@(value => this.SettingsManager.ConfigurationData.ModelComparison.PreselectOptions = value)" OptionHelp="@TA("When enabled, new presets and comparison series start with the models you preselect here, e.g., with the model you work with every day and want to test new models against.")" IsLocked="() => ManagedConfiguration.TryGet(x => x.ModelComparison, x => x.PreselectOptions, out var meta) && meta.IsLocked"/>
            <ConfigurationMinConfidenceSelection Disabled="@this.OptionsDisabled" RestrictToGlobalMinimumConfidence="@true" SelectedValue="@(() => this.SettingsManager.ConfigurationData.ModelComparison.MinimumProviderConfidence)" SelectionUpdate="@(value => this.SettingsManager.ConfigurationData.ModelComparison.MinimumProviderConfidence = value)" IsLocked="() => ManagedConfiguration.TryGet(x => x.ModelComparison, x => x.MinimumProviderConfidence, out var meta) && meta.IsLocked"/>
            <ConfigurationProviderSelection Component="Components.MODEL_COMPARISON_ASSISTANT" OptionDescription="@T("Preselected model")" NoPreselectionText="@T("No model preselected")" HelpText="@(() => TA("Every new preset of the Answer Test and every new comparison series of the Field Test starts with this model as its first model."))" Data="@this.AvailableLLMProviders" Disabled="@this.OptionsDisabled" SelectedValue="@(() => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedProvider)" SelectionUpdate="@(value => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedProvider = value)" IsLocked="() => ManagedConfiguration.TryGet(x => x.ModelComparison, x => x.PreselectedProvider, out var meta) && meta.IsLocked"/>
            <ConfigurationProviderSelection Component="Components.MODEL_COMPARISON_ASSISTANT" OptionDescription="@T("Preselected judge model")" NoPreselectionText="@T("No model preselected")" HelpText="@(() => TA("A preselected judge model switches the judge on in every new preset and every new comparison series. Without one, the judge stays off until you switch it on."))" Data="@this.AvailableLLMProviders" Disabled="@this.OptionsDisabled" SelectedValue="@(() => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedJudgeProvider)" SelectionUpdate="@(value => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedJudgeProvider = value)" IsLocked="() => ManagedConfiguration.TryGet(x => x.ModelComparison, x => x.PreselectedJudgeProvider, out var meta) && meta.IsLocked"/>
            <ConfigurationSelect OptionDescription="@T("Preselected preset")" Disabled="@this.OptionsDisabled" SelectedValue="@(() => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedPresetId)" Data="@this.PresetData" SelectionUpdate="@(value => this.SettingsManager.ConfigurationData.ModelComparison.PreselectedPresetId = value)" OptionHelp="@T("The Answer Test opens with this preset.")"/>
            @if (this.SelectedPresetMissing)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-6">@TA("The preselected preset no longer exists. Please select another preset.")</MudAlert>
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@this.Close" Variant="Variant.Filled">
            @T("Close")
        </MudButton>
    </DialogActions>
</MudDialog>