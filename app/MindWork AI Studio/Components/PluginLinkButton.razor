@using AIStudio.Tools.PluginSystem
@inherits MSGComponentBase

@if (PluginLinks.TryParse(this.Url, out var link))
{
    var isPlaceholder = IsPlaceholder(link);
    if (PluginLinks.IsMail(link))
    {
        <MudTooltip Text="@(isPlaceholder ? string.Empty : T("Send a mail"))">
            <MudIconButton Icon="@Icons.Material.Filled.Email" Href="@link.AbsoluteUri" Target="_blank" Size="@this.Size" Disabled="@isPlaceholder"/>
        </MudTooltip>
    }
    else
    {
        <MudTooltip Text="@(isPlaceholder ? T("No source url available") : T("Open website"))">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInBrowser" Href="@link.AbsoluteUri" Target="_blank" Size="@this.Size" Disabled="@isPlaceholder"/>
        </MudTooltip>
    }
}