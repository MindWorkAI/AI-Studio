@inherits MSGComponentBase

@if (this.CanDelete)
{
    <MudTooltip Text="@this.Tooltip">
        <MudIconButton Icon="@AppIcons.DELETE"
                       Color="Color.Error"
                       Variant="Variant.Text"
                       Size="Size.Medium"
                       Disabled="@(this.isDeleting || this.IsBlockedByActiveWork)"
                       OnClick="@this.DeletePluginAsync" />
    </MudTooltip>
}