@inherits MSGComponentBase

@if (ShouldShowInstallationPrompt(this.pandocInstallation))
{
    <MudStack Row="false" Class="mb-3 pa-3 border-dashed border rounded-lg">
        <MudJustifiedText Typo="Typo.body2">
            @this.PromptText
        </MudJustifiedText>
        <MudButton Color="@this.ButtonColor" Variant="Variant.Filled" OnClick="() => this.ShowPandocDialogAsync()">
            @this.ButtonText
        </MudButton>
    </MudStack>
}
