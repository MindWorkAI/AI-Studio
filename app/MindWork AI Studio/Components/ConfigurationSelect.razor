@inherits ConfigurationBaseCore
@typeparam TConfig

<MudSelect T="TConfig" Value="@this.SelectedValue()" Strict="@true" ShrinkLabel="@true" Disabled="@this.IsDisabled" Margin="Margin.Dense" Class="@this.SelectCssClass" Style="@this.SelectStyle" Underline="false" ValueChanged="@this.OptionChanged">
    @foreach (var data in this.Data)
    {
        <MudSelectItem Value="@data.Value">
            @if (this.ItemTemplate is null)
            {
                @data.Name
            }
            else
            {
                @this.ItemTemplate(data)
            }
        </MudSelectItem>
    }
</MudSelect>
