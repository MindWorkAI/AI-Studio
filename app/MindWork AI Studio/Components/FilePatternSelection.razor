@inherits MSGComponentBase

<MudStack Spacing="1" Class="mb-3">
    <div style="@PATTERN_ROW_STYLE">
        <div style="min-width: 0;">
            @this.AllowedContent
        </div>
        <MudTooltip Text="@T("Pattern help and examples")" RootStyle="display: inline-flex;">
            <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Color="@(this.showHelp ? Color.Info : Color.Default)" OnClick="@this.ToggleHelp" aria-label="@T("Pattern help and examples")" aria-expanded="@(this.showHelp ? "true" : "false")"/>
        </MudTooltip>
    </div>
    @if (this.HasExclusions)
    {
        <div style="@PATTERN_ROW_STYLE">
            <div style="grid-column: 1; min-width: 0;" class="mt-3">
                @this.ExcludedContent
            </div>
        </div>
    }
    <MudCollapse Expanded="@this.showHelp">
        <div style="@PATTERN_ROW_STYLE">
            <MudPaper Outlined="@true" Class="pa-3" Elevation="0" Style="grid-column: 1; min-width: 0;">
                <MudText Typo="Typo.subtitle2">@T("Pattern examples")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@T("Separate patterns with semicolons. Exclusions take priority over included files.")</MudText>
                <MudSimpleTable Dense="@true" Elevation="0" aria-label="@T("Pattern examples")">
                    <tbody>
                        <tr><td><code>*.pdf;*.docx</code></td><td>@T("PDF and Word files")</td></tr>
                        <tr><td><code>:documents:</code></td><td>@T("Include all documents and readable text files")</td></tr>
                        <tr><td><code>*</code></td><td>@T("Include all files, including audio and video")</td></tr>
                        <tr><td><code>:text:</code></td><td>@T("Include readable text files, including files without an extension")</td></tr>
                        <tr><td><code>draft-*</code></td><td>@T("File names starting with draft-")</td></tr>
                        @if (this.HasExclusions)
                        {
                            <tr><td><code>*build/</code></td><td>@T("Exclude folders ending in build, such as build or app-build")</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@T("Patterns match file names regardless of letter case. Folder paths are not supported.")</MudText>
            </MudPaper>
        </div>
    </MudCollapse>
</MudStack>
