@inherits ConfigurationBaseCore

@if (this.ResetValue is null)
{
    <MudTextField
        T="string"
        Text="@(this.ExpandToContent ? this.EditingText : this.Text())"
        TextChanged="@this.InternalUpdate"
        Disabled="@this.IsDisabled"
        Adornment="@this.IconAdornment"
        AdornmentIcon="@this.Icon"
        AdornmentColor="@this.IconColor"
        UserAttributes="@SPELLCHECK_ATTRIBUTES"
        Lines="@this.NumLines"
        AutoGrow="@this.AutoGrow"
        MaxLines="@this.GetMaxLines"
        Class="@this.InputClass"
        Immediate="@true"
        Validation="@this.Validation"
        Underline="false"
    />
}
else
{
    @* One element, since a locked option places it next to its lock icon: *@
    <div>
        <MudTextField
            T="string"
            Text="@(this.ExpandToContent ? this.EditingText : this.Text())"
            TextChanged="@this.InternalUpdate"
            Disabled="@this.IsDisabled"
            Adornment="@(this.ResetButtonIconOnly ? Adornment.End : this.IconAdornment)"
            AdornmentIcon="@(this.ResetButtonIconOnly ? Icons.Material.Filled.Restore : this.Icon)"
            OnAdornmentClick="@this.ResetAdornmentClick"
            AdornmentAriaLabel="@(this.ResetButtonIconOnly ? this.ResetButtonText : null)"
            AdornmentColor="@this.IconColor"
            UserAttributes="@SPELLCHECK_ATTRIBUTES"
            Lines="@this.NumLines"
            AutoGrow="@this.AutoGrow"
            MaxLines="@this.GetMaxLines"
            Class="@this.InputClass"
            Immediate="@true"
            Validation="@this.Validation"
            Underline="false"
        />
        @if (!this.ResetButtonIconOnly)
        {
            <RestoreDefaultButton Text="@this.ResetButtonText" Disabled="@this.IsDisabled" OnClick="@this.ResetTextAsync"/>
        }
    </div>
}