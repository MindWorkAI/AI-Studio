@inherits MSGComponentBase

<MudStack Row="@true" AlignItems="@AlignItems.Center" Spacing="0">
    <MudTooltip Text="@T("Show in the file manager")" Placement="Placement.Top">
        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" OnClick="@this.ShowInFileManager"/>
    </MudTooltip>
    @if (this.OffersOpening)
    {
        <MudTooltip Text="@T("Open with the default program")" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick="@this.OpenWithDefaultProgram"/>
        </MudTooltip>
    }
</MudStack>