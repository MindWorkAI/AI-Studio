@inherits MSGComponentBase

@if (this.IsSearching)
{
    @* A slim row above the messages, which counts what it finds in this chat only. Its numbers belong to
       the chat, while the top of the sidebar counts the results in the list. It has no close button of
       its own: it ends with the search. *@
    <SearchStepRow Text="@this.FindText" CanStep="@(this.matchCount > 0)" PreviousLabel="@T("Previous match in this chat")" NextLabel="@T("Next match in this chat")" StepRequested="@this.StepAsync" Class="mb-2"/>
}