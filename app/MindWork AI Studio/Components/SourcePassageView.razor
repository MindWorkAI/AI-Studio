@using AIStudio.Tools.RAG
@inherits MSGComponentBase

@if (this.Passage.Category is RetrievalContentCategory.IMAGE)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @T("An image matched here. The AI was told about it and where to find it, but it did not receive the image itself.")
    </MudAlert>
}
else
{
    <ContentViewer Text="@this.text" MaxHeight="@this.MaxHeight">
        <Toolbar>
            @* The heading takes the free width, so the button stands right, next to the views. *@
            <MudText Typo="Typo.subtitle2" Class="flex-grow-1">
                @this.heading
            </MudText>

            @if (this.documentAtPassage is { } document)
            {
                @* On hover only: the focus comes back to the button from the program the document opens
                   in, and a tooltip shown on focus would then stay until the user clicks somewhere else. *@
                <MudTooltip Text="@this.openTooltip" Placement="Placement.Top" ShowOnFocus="@false">
                    <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Class="icon-button-compact" OnClick="@(() => document.OpenAsync(this.RustService))"/>
                </MudTooltip>
            }
        </Toolbar>
    </ContentViewer>
}