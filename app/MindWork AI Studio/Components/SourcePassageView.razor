@using AIStudio.Tools.RAG
@inherits MSGComponentBase

@if (this.Passage.Category is RetrievalContentCategory.IMAGE)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @T("An image matched here. The AI was told about it and where to find it, but it did not receive the image itself.")
    </MudAlert>
}
else
{
    @if (this.isTextMissing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
            @T("AI Studio no longer has the text the AI received from this passage. Only where it was found is still known.")
        </MudAlert>
    }
    else if (this.isReadingText)
    {
        <MudProgressLinear Indeterminate="@true" Color="Color.Primary" Size="Size.Small" Class="mb-2"/>
    }

    <ContentViewer Text="@this.text" MaxHeight="@this.MaxHeight">
        <Toolbar>
            @* The heading takes the free width, so the button stands right, next to the views. *@
            <MudText Typo="Typo.subtitle2" Class="flex-grow-1">
                @this.heading
            </MudText>

            <FileActions Path="@this.openPath" PageNumber="@this.openPage" ShowCopy="@false" ShowFileManager="@false" OpenTooltip="@this.openTooltip"/>
        </Toolbar>
    </ContentViewer>
}