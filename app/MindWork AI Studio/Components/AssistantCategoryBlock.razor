@if (this.HasVisibleAssistant)
{
    <AssistantCategoryHeader Category="@this.Category" IsCollapsed="@this.IsCollapsed" OnToggleCollapsed="@this.ToggleCollapsedAsync" Class="@this.HeaderClass"/>
}
<CascadingValue Value="this" IsFixed="@true">
    <MudStack Row="@true" Wrap="@Wrap.Wrap" Class="@this.StackClass">
        @this.ChildContent
        @foreach (var plugin in this.Plugins)
        {
            <AssistantPluginBlock @key="@plugin.Id" Plugin="@plugin"/>
        }
    </MudStack>
</CascadingValue>