@using AIStudio.Settings
@using AIStudio.Settings.DataModel
@inherits SettingsPanelBase

<ExpansionPanel HeaderIcon="@Icons.Material.Filled.Build" HeaderText="@T("Tool Settings")">
    <MudText Typo="Typo.body1" Class="mb-4">
        @T("Configure global settings for each tool.") @T("Switch off the tools you never need: they then appear in no tool selection, and the AI cannot use them.")
    </MudText>

    <ConfigurationSelect OptionDescription="@T("Confirm tool calls")" SelectedValue="@(() => this.SettingsManager.ConfigurationData.Tools.ToolApprovalMode)" Data="@ConfigurationSelectDataFactory.GetToolApprovalModeData()" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.Tools.ToolApprovalMode = selectedValue)" OptionHelp="@T("Decide which tool calls you confirm before they run. Critical calls send what the AI wrote to third parties, such as the query of a web search. Tools which stay within your organization, such as the search of your data sources, are not critical. In every case, a chat which holds internal content does not use tools which would carry it outside.")" IsLocked="() => ManagedConfiguration.TryGet(x => x.Tools, x => x.ToolApprovalMode, out var meta) && meta.IsLocked"/>
    <ConfigurationOption OptionDescription="@T("Allow a tool for a whole chat?")" LabelOn="@T("A confirmation may allow the tool for the rest of the chat")" LabelOff="@T("Every call has to be confirmed on its own")" State="@(() => this.SettingsManager.ConfigurationData.Tools.AllowApprovingToolsForWholeChat)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.Tools.AllowApprovingToolsForWholeChat = updatedState)" OptionHelp="@T("When enabled, you can allow a tool for the rest of a chat while confirming one of its calls, and assistants which work out of sight ask once before they start. When disabled, such assistants cannot use tools which need your confirmation.")" IsLocked="() => ManagedConfiguration.TryGet(x => x.Tools, x => x.AllowApprovingToolsForWholeChat, out var meta) && meta.IsLocked"/>

    <MudTable Items="@this.items" Hover="@true" Dense="@true">
        <HeaderContent>
            <MudTh>@T("Enabled")</MudTh>
            <MudTh>@T("Icon")</MudTh>
            <MudTh>@T("Name")</MudTh>
            <MudTh>@T("Description")</MudTh>
            <MudTh>@T("Minimum provider confidence")</MudTh>
            <MudTh>@T("Status")</MudTh>
            <MudTh>@T("Settings")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudTooltip Text="@this.GetSwitchTooltip(context)">
                    <MudSwitch T="bool" Value="@context.IsActive" ValueChanged="@(isOn => this.SwitchToolOnOrOff(context, isOn))" Disabled="@IsSwitchLocked(context)" Color="Color.Primary" />
                </MudTooltip>
            </MudTd>
            <MudTd>
                <MudIcon Icon="@context.Icon" Color="Color.Info" />
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body1">@context.DisplayName</MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.body2">@context.Description</MudText>
            </MudTd>
            <MudTd>
                <MudMenu StartIcon="@Icons.Material.Filled.Security" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="@this.GetCurrentConfidenceLevelName(context)" Variant="Variant.Filled" Style="@this.SetCurrentConfidenceLevelColorStyle(context)" Disabled="@this.IsToolConfidenceManaged()">
                    @foreach (var confidenceLevel in this.GetSelectableConfidenceLevels())
                    {
                        <MudMenuItem OnClick="@(async () => await this.ChangeMinimumProviderConfidence(context, confidenceLevel))">
                            @this.GetConfidenceLevelName(confidenceLevel)
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTd>
            <MudTd>
                @if (IsSwitchedOffByUser(context))
                {
                    @* Whether its settings are complete does not matter while nobody can use the tool: *@
                    <MudTooltip Text="@T("You switched off this tool. It appears in no tool selection, and the AI cannot use it.")">
                        <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Default" />
                    </MudTooltip>
                }
                else if (!context.IsActive)
                {
                    <MudTooltip Text="@T("This tool has been disabled by your organization.")">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" />
                    </MudTooltip>
                }
                else if (context.ConfigurationState.IsConfigured)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
                else
                {
                    <MudTooltip Text="@this.GetConfigurationTooltip(context)">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Wrap="Wrap.NoWrap" AlignItems="AlignItems.Center" Spacing="0">
                    <MudTooltip Text="@T("Settings")">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="@(async () => await this.OpenSettings(context))" aria-label="@T("Settings")" />
                    </MudTooltip>
                    <AdminExportButton OnClick="@(() => this.OpenExport(context))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
</ExpansionPanel>
