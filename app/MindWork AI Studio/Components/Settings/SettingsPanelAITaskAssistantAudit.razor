@using AIStudio.Settings
@inherits SettingsPanelBase

<ExpansionPanel HeaderIcon="@AppIcons.SECURITY_AUDIT" HeaderText="@T("AI Task: Security Audit for external Assistants")">
    <MudPaper Class="pa-3 mb-8 border-dashed border rounded-lg">
        <MudJustifiedText Typo="Typo.body1" Class="mb-3">
            @T("Before external assistants are activated, a model audits newly installed or updated ones for security risks. AI Studio keeps the latest audit card until the plugin manifest changes.")
        </MudJustifiedText>
        <ConfigurationOption OptionDescription="@T("Require a security audit before activating external Assistants?")" LabelOn="@T("External Assistants must be audited before activation")" LabelOff="@T("External Assistant can be activated without an audit")" State="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.RequireAuditBeforeActivation)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.AssistantPluginAudit.RequireAuditBeforeActivation = updatedState)" ConfirmChange="@this.ConfirmRequireAuditBeforeActivationChange" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.RequireAuditBeforeActivation, out var meta) && meta.IsLocked"/>
        <ConfigurationMinConfidenceSelection RestrictToGlobalMinimumConfidence="@true" SelectedValue="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.MinimumProviderConfidence)" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.AssistantPluginAudit.MinimumProviderConfidence = selectedValue)" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.MinimumProviderConfidence, out var meta) && meta.IsLocked"/>
        <ConfigurationProviderSelection Component="Components.AGENT_ASSISTANT_PLUGIN_AUDIT" EmptySelectionText="@T("Use the app default, otherwise the model chosen when auditing")" Data="@this.AvailableLLMProvidersFunc()" SelectedValue="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.PreselectedAgentProvider)" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.AssistantPluginAudit.PreselectedAgentProvider = selectedValue)" HelpText="@(() => TA("Optionally choose a dedicated provider for assistant plugin audits. When left empty, AI Studio uses the app-wide default provider, or else the model you choose when auditing."))" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.PreselectedAgentProvider, out var meta) && meta.IsLocked"/>
        <ConfigurationSelect OptionDescription="@T("Minimum required audit level")" SelectedValue="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.MinimumLevel)" Data="@ConfigurationSelectDataFactory.GetAssistantAuditLevelsData()" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.AssistantPluginAudit.MinimumLevel = selectedValue)" OptionHelp="@T("External Assistants rated below this audit level are treated as insufficiently reviewed.")" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.MinimumLevel, out var meta) && meta.IsLocked"/>
        <ConfigurationOption OptionDescription="@T("Block activation below the minimum Audit-Level?")" LabelOn="@T("Activation is blocked below the minimum Audit-Level")" LabelOff="@T("Users may still activate plugins below the minimum Audit-Level")" State="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.BlockActivationBelowMinimum)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.AssistantPluginAudit.BlockActivationBelowMinimum = updatedState)" 
                             OptionHelp="@TA("The audit shows you all security risks and information. If you consider this rating false at your own discretion, you can decide to install it anyway (not recommended).")" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.BlockActivationBelowMinimum, out var meta) && meta.IsLocked"/>
        <ConfigurationOption OptionDescription="@T("Automatically audit new or updated plugins in the background?")" LabelOn="@T("Security audit is automatically done in the background")" LabelOff="@T("Security audit is done manually by the user")" State="@(() => this.SettingsManager.ConfigurationData.AssistantPluginAudit.AutomaticallyAuditAssistants)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.AssistantPluginAudit.AutomaticallyAuditAssistants = updatedState)" IsLocked="() => ManagedConfiguration.TryGet(x => x.AssistantPluginAudit, x => x.AutomaticallyAuditAssistants, out var meta) && meta.IsLocked"/>
        @if (this.IsAutomaticAuditWithoutProvider)
        {
            <MudAlert Severity="Severity.Warning" Dense="@true" Class="mb-3">
                <MudJustifiedText Typo="Typo.body2">
                    @TA("Automatic audits cannot run, because no model is available for security checks. Choose one above, or set an app-wide default provider in the app options.")
                </MudJustifiedText>
            </MudAlert>
        }
    </MudPaper>
</ExpansionPanel>
