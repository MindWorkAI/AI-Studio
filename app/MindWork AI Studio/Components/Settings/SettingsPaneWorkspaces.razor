@using AIStudio.Settings
@using AIStudio.Settings.DataModel
@inherits SettingsPanelBase

<SettingsGroup Title="@T("Workspaces")">
    <ConfigurationOption OptionDescription="@T("Use workspaces?")" LabelOn="@T("Workspaces are used")" LabelOff="@T("No workspaces are used")" State="@(() => this.SettingsManager.ConfigurationData.Workspace.UsesWorkspaces)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.Workspace.AreWorkspacesEnabled = updatedState)" OptionHelp="@T("When enabled, chats can be sorted into workspaces. When disabled, chats in workspaces are hidden but kept.")"/>

    @* Chats in workspaces are kept by a choice of their own, independent of all other chats: *@
    @if (this.SettingsManager.ConfigurationData.Workspace.UsesWorkspaces)
    {
        <ConfigurationSelect OptionDescription="@T("Store chats in workspaces")" SelectedValue="@(() => this.WorkspaceChoiceShown)" Data="@ConfigurationSelectDataFactory.GetWorkspaceChatStorageChoiceData(this.ChoiceOfAllChats)" SelectionUpdate="@(choice => this.SettingsManager.ConfigurationData.Workspace.SetChoice(isInWorkspace: true, choice))" OptionHelp="@T("Whether and how long chats in workspaces are stored.")"/>
        @if (this.SettingsManager.ConfigurationData.Workspace.GetChoice(isInWorkspace: true) is ChatStorageChoice.STORE_TEMPORARILY)
        {
            <ConfigurationSelect OptionDescription="@T("For how long")" SelectedValue="@(() => this.SettingsManager.ConfigurationData.Workspace.GetDuration(isInWorkspace: true))" Data="@ConfigurationSelectDataFactory.GetChatDurationData()" SelectionUpdate="@(duration => this.SettingsManager.ConfigurationData.Workspace.SetDuration(isInWorkspace: true, duration))" OptionHelp="@T("Chats in workspaces are deleted when they have not changed for this long, including chats stored before this option was chosen.")"/>
        }
    }
</SettingsGroup>

@* The sidebar shows whenever it has something to list, the stored chats or the workspaces: *@
@if (this.SettingsManager.ConfigurationData.Workspace.IsChatListShown)
{
    <SettingsGroup Title="@T("Sidebar")">
        <ConfigurationSelect OptionDescription="@T("Workspace display behavior")" SelectedValue="@(() => this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior)" Data="@ConfigurationSelectDataFactory.GetWorkspaceDisplayBehaviorData()" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior = selectedValue)" OptionHelp="@T("How workspaces are displayed. In a narrow window, they appear over the chat.")"/>
    </SettingsGroup>
}