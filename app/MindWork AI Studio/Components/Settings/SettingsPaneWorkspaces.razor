@using AIStudio.Settings
@using AIStudio.Settings.DataModel
@inherits SettingsPanelBase

@* Whether chats are stored, and how long, is set in the pane of the chat: workspaces only sort the stored chats. *@
<SettingsGroup Title="@T("Workspaces")">
    <ConfigurationOption OptionDescription="@T("Use workspaces?")" LabelOn="@T("Workspaces are used")" LabelOff="@T("No workspaces are used")" State="@(() => this.SettingsManager.ConfigurationData.Workspace.UsesWorkspaces)" StateUpdate="@(updatedState => this.SettingsManager.ConfigurationData.Workspace.AreWorkspacesEnabled = updatedState)" OptionHelp="@T("When enabled, you can sort your chats into workspaces, where they stay until you delete them. When disabled, the sidebar lists your disappearing chats only; chats already in a workspace are kept and come back when you enable workspaces again. While your chats are not stored, no new chat goes into a workspace.")"/>
</SettingsGroup>

@* The sidebar shows whenever it has something to list, the stored chats or the workspaces: *@
@if (this.SettingsManager.ConfigurationData.Workspace.IsChatListShown)
{
    <SettingsGroup Title="@T("Sidebar")">
        <ConfigurationSelect OptionDescription="@T("Workspace display behavior")" SelectedValue="@(() => this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior)" Data="@ConfigurationSelectDataFactory.GetWorkspaceDisplayBehaviorData()" SelectionUpdate="@(selectedValue => this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior = selectedValue)" OptionHelp="@T("How should we display your workspaces?")"/>
    </SettingsGroup>
}