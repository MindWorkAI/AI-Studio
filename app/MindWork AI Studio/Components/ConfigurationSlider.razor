@using Microsoft.AspNetCore.Components.Web
@typeparam T
@inherits ConfigurationBaseCore

@* The input event bubbles up from the range input inside, also while the value waits for the release: *@
<MudSlider T="@T" Size="Size.Medium" Value="@this.Value()" ValueChanged="@this.OptionChanged" Min="@this.Min" Max="@this.Max" Step="@this.Step" Immediate="@this.Immediate" Disabled="@this.IsDisabled" Class="mb-1" @oninput="@this.ShowDraggedValue">
    @(this.draggedValue ?? this.Value()) @this.Unit
</MudSlider>