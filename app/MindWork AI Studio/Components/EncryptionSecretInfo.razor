<MudText Typo="Typo.body1" Class="@this.Class">
    <div style="display: flex; align-items: center; gap: 8px;">
        <MudIcon Icon="@AppIcons.INFO_ROW"/>
        @if (this.IsConfigured)
        {
            <MudIcon Icon="@AppIcons.SUCCESS" Color="Color.Success" Size="Size.Small"/>
            <span>@this.ConfiguredText</span>
        }
        else
        {
            <MudIcon Icon="@AppIcons.WARNING" Color="Color.Error" Size="Size.Small"/>
            <span>@this.NotConfiguredText</span>
        }
    </div>
</MudText>