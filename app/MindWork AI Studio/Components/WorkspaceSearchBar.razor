@inherits MSGComponentBase

@* Only while the field holds words: before, the list has no results to count. The block keeps the
   inset of the rows of the list. *@
@if (!string.IsNullOrWhiteSpace(this.Search.Text))
{
    <SearchStepRow Text="@this.ResultText" CanStep="@(this.Search.ResultCount > 0)" PreviousLabel="@T("Previous result in the list")" NextLabel="@T("Next result in the list")" StepRequested="@this.Search.Step" Style="margin: 6px 6px 4px;">

        @* Where the search found the current result, below the count it belongs to. One short line of
           fixed height, so the list below never moves when its text changes. The passage itself shows
           in the tooltip, where there is room for it: *@
        <div class="workspace-search-reason mud-text-secondary">
            @if (this.Search.CurrentReason.IsInContent)
            {
                @* The tooltip gives what the line has no room for, like the tooltip of a found chat: *@
                <MudTooltip Placement="Placement.Bottom" Delay="@ChatSearchPassageView.TOOLTIP_DELAY" RootStyle="display: flex; min-width: 0;">
                    <ChildContent>
                        <span class="workspace-search-reason-text">@this.ReasonText</span>
                    </ChildContent>
                    <TooltipContent>
                        <div style="@ChatSearchPassageView.TOOLTIP_CONTENT_STYLE">
                            <ChatSearchPassageView Passage="@this.Search.CurrentReason.Passage" Terms="@SearchText.ParseTerms(this.Search.Text)"/>
                        </div>
                    </TooltipContent>
                </MudTooltip>
            }
            else
            {
                <span class="workspace-search-reason-text">@this.ReasonText</span>
            }
        </div>

        @* At the bottom edge of the block, below the line, so the block keeps its height when the
           progress shows up and goes: *@
        @if (this.Search.IsSearchingContents)
        {
            <MudProgressLinear Indeterminate="@true" Color="Color.Primary" Size="Size.Small" Style="position: absolute; left: 8px; right: 8px; bottom: 1px; width: auto;"/>
        }
    </SearchStepRow>
}