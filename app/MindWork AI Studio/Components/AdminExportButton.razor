{
    <MudTooltip Text="@T("Export configuration")">
        <MudIconButton Variant="@this.Variant" Color="Color.Info" Icon="@AppIcons.EXPORT_CONFIGURATION" OnClick="@this.Export" aria-label="@T("Export configuration")" />
    </MudTooltip>
}