@using AIStudio.Settings.DataModel
@using AIStudio.Chat

@inherits MSGComponentBase

<InnerScrolling FillEntireHorizontalSpace="@true" @ref="@this.scrollingArea" MinWidth="36em" Style="height: 100%">
    <HeaderContent>
        @* Where the open chat is, at the top of the chat: its workspace, or the chats outside of
           workspaces, and its own name, which follows the message being written into a new chat. *@
        <MudStack Row="@true" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap" Spacing="1" Class="px-1" Style="height: 40px; min-width: 0;">
            @if (!string.IsNullOrWhiteSpace(this.BreadcrumbPlace))
            {
                <MudText Typo="Typo.body1" Class="mud-text-secondary flex-shrink-0" Style="@BREADCRUMB_PLACE_STYLE">
                    @this.BreadcrumbPlace
                </MudText>
                <MudIcon Icon="@AppIcons.BREADCRUMB_SEPARATOR" Size="Size.Small" Class="flex-shrink-0" Style="color: var(--mud-palette-text-disabled);"/>
            }
            <MudText Typo="Typo.body1" Style="@BREADCRUMB_CHAT_STYLE">
                @this.BreadcrumbChatName
            </MudText>
        </MudStack>

        @* The provider of the chat, which cannot change while an answer is being written: another
           provider would not reach the answer, which keeps the one it started with, but the chat
           would show the other one meanwhile. *@
        <CascadingValue Value="Components.CHAT">
            <ProviderSelection ProviderSettings="@this.Provider" ProviderSettingsChanged="@this.SelectProviderAsync" Disabled="@this.IsCurrentChatStreaming"/>
        </CascadingValue>

        @if (this.Search is not null)
        {
            <ChatFindBar Search="@this.Search" ChatId="@(this.ChatThread?.ChatId ?? Guid.Empty)" Messages="@(() => this.messagesElement)" UnsentMessageFieldId="@CHAT_INPUT_ID"/>
        }
    </HeaderContent>
    <ChildContent>
        @* The element around the messages is where the search of the page finds its words, see ChatFindBar: *@
        <div @ref="@this.messagesElement">
            @if (this.ChatThread is not null)
            {
                var blocks = this.ChatThread.Blocks.OrderBy(n => n.Time).ToList();
                var sendToDestinations = this.AssistantLaunchService.GetDestinationsFor(Components.CHAT);
                for (var i = 0; i < blocks.Count; i++)
                {
                    var block = blocks[i];
                    var isLastBlock = i == blocks.Count - 1;
                    var isSecondLastBlock = i == blocks.Count - 2;
                    @if (block is { HideFromUser: false, Content: not null })
                    {
                        <ContentBlockComponent
                            @key="@block"
                            Role="@block.Role"
                            Type="@block.ContentType"
                            Time="@block.Time"
                            Content="@block.Content"
                            ExportFileName="@this.ChatThread.Name"
                            RemoveBlockFunc="@this.RemoveBlock"
                            IsLastContentBlock="@isLastBlock"
                            IsSecondToLastBlock="@isSecondLastBlock"
                            RegenerateFunc="@this.RegenerateBlock"
                            RegenerateEnabled="@(() => this.IsProviderSelected && this.ChatThread.IsLLMProviderAllowed(this.Provider))"
                            RollbackFunc="@this.RollbackBlock"
                            BlockActionsEnabled="@(() => this.blockActions.AreAllowed(this.ChatThread))"
                            EditLastBlockFunc="@this.EditLastBlock"
                            EditLastUserBlockFunc="@this.EditLastUserBlock"
                            SendToFunc="@this.SendBlockToAsync"
                            SendToDestinations="@sendToDestinations"/>
                    }
                }
            }
        </div>
    </ChildContent>
    <FooterContent>
        <MediaTranscriptionStatus Owner="@this.CurrentMediaImportOwner"/>
        <MudElement Style="flex: 0 0 auto;">
            <MudTextField
                T="string"
                @ref="@this.inputField"
                @bind-Text="@this.UserInput"
                @bind-Text:after="@this.FollowComposerAsync"
                Variant="Variant.Outlined"
                Sizing="InputSizing.Auto"
                Lines="3"
                MaxLines="12"
                Label="@this.InputLabel"
                Placeholder="@this.ProviderPlaceholder"
                Adornment="Adornment.End"
                AdornmentIcon="@(this.MediaTranscriptionService.IsBusy(this.CurrentMediaImportOwner) ? AppIcons.PENDING : AppIcons.SEND)"
                OnAdornmentClick="() => this.SendMessage()"
                Disabled="@this.IsInputForbidden()"
                Immediate="@true"
                OnKeyUp="@this.InputKeyEvent"
                UserAttributes="@USER_INPUT_ATTRIBUTES"
                Class="@this.UserInputClass"
                HelperText="@this.TokenCountMessage"
                Style="@this.UserInputStyle"/>
        </MudElement>
        <MudToolBar WrapContent="true" Gutters="@false" Class="border border-solid rounded" Style="border-color: lightgrey; gap: 2px;">
            @if (this.ChatStorage is WorkspaceStorageBehavior.STORE_CHATS_MANUALLY)
            {
                <MudTooltip Text="@T("Save chat")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.SAVE" OnClick="@(() => this.SaveThread())" Disabled="@(!this.CanThreadBeSaved || this.IsCurrentChatStreaming)"/>
                </MudTooltip>
            }

            @* One button for a new chat, which follows the open chat: its next chat goes into the same workspace, or outside of workspaces. Other places offer the workspace tree. While the open chat is the new chat of its place, the button would only open it again, so it stays disabled until the first message, as the other buttons of the toolbar do when they cannot act. *@
            @if (string.IsNullOrWhiteSpace(this.currentWorkspaceName))
            {
                <MudTooltip Text="@T("Start a new chat")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.NEW_CHAT" Disabled="@this.IsNewChat" OnClick="@(() => this.StartNewChat(useSameWorkspace: false))"/>
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="@this.TooltipAddChatToWorkspace" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.NEW_CHAT_IN_WORKSPACE" Disabled="@this.IsNewChat" OnClick="@(() => this.StartNewChat(useSameWorkspace: true))"/>
                </MudTooltip>
            }

            <ChatTemplateSelection MarginLeft="" CanChatThreadBeUsedForTemplate="@this.CanThreadBecomeTemplate" CurrentChatThread="@this.ChatThread" CurrentChatTemplate="@this.currentChatTemplate" CurrentChatTemplateChanged="@this.ChatTemplateWasChanged"/>
            

            @if (this.ChatStorage is WorkspaceStorageBehavior.STORE_CHATS_AUTOMATICALLY)
            {
                <MudTooltip Text="@T("Delete this chat & start a new one.")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.DELETE_CHAT_AND_START_NEW" Color="Color.Error" OnClick="@(() => this.StartNewChat(useSameWorkspace: true, deletePreviousChat: true))" Disabled="@(!this.CanThreadBeSaved || this.IsCurrentChatStreaming)"/>
                </MudTooltip>
            }

            @if (this.SettingsManager.ConfigurationData.Workspace.CanChatsGoIntoWorkspaces)
            {
                <MudTooltip Text="@TA("Move the chat to a workspace, or to another if it is already in one.")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.MOVE_TO_WORKSPACE" Disabled="@(!this.CanThreadBeMoved)" OnClick="@this.MoveChatToWorkspace"/>
                </MudTooltip>
            }

            @if (this.ChatStorage is not WorkspaceStorageBehavior.DISABLE_WORKSPACES)
            {
                <MudTooltip Text="@T("Copy this chat & continue in the copy.")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.DUPLICATE" Disabled="@(!this.CanThreadBeCopied)" OnClick="@this.CopyCurrentChat"/>
                </MudTooltip>
            }
            
            <AttachDocuments Name="File Attachments" DocumentPaths="@this.ComposerState.FileAttachments" DocumentPathsChanged="@this.ComposerAttachmentsChanged" CatchAllDocuments="true" UseSmallForm="true" ShowMediaStatus="false" Provider="@this.Provider" OwnerChat="@this.ChatThread" EnsureOwnerChatAsync="@this.EnsureMediaImportChatAsync" KeepPreviewedText="@this.KeepPreviewedTextAsync" Disabled="@(!this.CanAttachFiles)"/>

            <MudTooltip Text="@TA("Clear your message and its attachments")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.CLEAR" OnClick="@this.ClearComposerAsync" Disabled="@(!this.CanAttachFiles || !this.ComposerState.HasComposerContent)"/>
            </MudTooltip>
            
            <MudTooltip Text="@T("Show all files attached to this chat")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.ATTACHED_FILES" Disabled="@(!this.HasSentFileAttachments)" OnClick="@this.ShowSentFileAttachments"/>
            </MudTooltip>
            
            <MudDivider Vertical="true" Style="height: 24px; align-self: center;"/>
            
            <MudTooltip Text="@T("Bold")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.FORMAT_BOLD" OnClick="@(() => this.ApplyMarkdownFormat(MARKDOWN_BOLD))" Disabled="@this.IsInputForbidden()"/>
            </MudTooltip>
            <MudTooltip Text="@T("Italic")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.FORMAT_ITALIC" OnClick="@(() => this.ApplyMarkdownFormat(MARKDOWN_ITALIC))" Disabled="@this.IsInputForbidden()"/>
            </MudTooltip>
            <MudTooltip Text="@T("Heading")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.HEADING" OnClick="@(() => this.ApplyMarkdownFormat(MARKDOWN_HEADING))" Disabled="@this.IsInputForbidden()"/>
            </MudTooltip>
            <MudTooltip Text="@T("Bulleted List")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.FORMAT_BULLET_LIST" OnClick="@(() => this.ApplyMarkdownFormat(MARKDOWN_BULLET_LIST))" Disabled="@this.IsInputForbidden()"/>
            </MudTooltip>
            <MudTooltip Text="@T("Code")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.FORMAT_CODE" OnClick="@(() => this.ApplyMarkdownFormat(MARKDOWN_CODE))" Disabled="@this.IsInputForbidden()"/>
            </MudTooltip>
            
            <MudDivider Vertical="true" Style="height: 24px; align-self: center;"/>
            
            <MudTooltip Text="@T("Show the complete system prompt the AI receives")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@AppIcons.PREVIEW" OnClick="@this.ShowSystemPrompt"/>
            </MudTooltip>

            <ProfileSelection MarginLeft="" CurrentProfile="@this.currentProfile" CurrentProfileChanged="@this.ProfileWasChanged" Disabled="@(!this.CanProfileBeChanged)" DisabledText="@this.ProfileDisabledText"/>

            @if (this.SettingsManager.AreToolsEnabled())
            {
                <ToolSelection Component="Components.CHAT" LLMProvider="@this.Provider" RequiredOutboundDataRestriction="@(this.ChatThread?.RequiredOutboundDataRestriction ?? OutboundDataRequirement.NONE)" SelectedToolIds="@this.selectedToolIds" SelectedToolIdsChanged="@this.SelectedToolIdsChanged" Disabled="@this.IsCurrentChatStreaming" />
            }
            
            @if (PreviewFeatures.PRE_RAG_2024.IsEnabled(this.SettingsManager))
            {
                <DataSourceSelection @ref="@this.dataSourceSelectionComponent" LLMProvider="@this.Provider" DataSourceOptions="@this.GetCurrentDataSourceOptions()" DataSourceOptionsChanged="@this.DataSourceOptionsWereChanged" DataSourcesAISelected="@this.GetAgentSelectedDataSources()" ReadOnly="@this.IsCurrentChatStreaming" ReadOnlyMessage="@TA("Data source changes are locked while a response is running. Your current selection is shown below and applies again from the next message once the run is finished.")"/>
            }
            
            @if (this.SettingsManager.ConfigurationData.Confidence.ShowProviderConfidence)
            {
                <ConfidenceInfo LLMProvider="@this.Provider.UsedLLMProvider"/>
            }

            @if (this.IsCurrentChatStreaming)
            {
                <MudTooltip Text="@T("Stop generation")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.STOP" Color="Color.Error" OnClick="@this.CancelStreaming"/>
                </MudTooltip>
            }

            @if (!this.ChatThread.IsLLMProviderAllowed(this.Provider))
            {
                <MudTooltip Text="@(this.SettingsManager.IsProviderProhibited(this.Provider.UsedLLMProvider) ? TA("The use of this provider has been prohibited by your organization. Please select a different provider.") : T("The selected provider is not allowed in this chat due to data security or confidence-level requirements."))" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@AppIcons.WARNING" Color="Color.Error"/>
                </MudTooltip>
            }
            
            <MudSpacer />
            <HalluzinationReminder ContainerClass="my-0 ml-2 me-2"/>
        </MudToolBar>
    </FooterContent>
</InnerScrolling>
