<tr>
    <td style="width: 210px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@this.Icon" Size="Size.Small"/>
            <MudText Typo="Typo.body2"><b>@this.Label</b></MudText>
        </MudStack>
    </td>
    <td>
        @this.ChildContent
    </td>
</tr>