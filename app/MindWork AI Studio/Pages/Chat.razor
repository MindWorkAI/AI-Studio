@attribute [Route(Routes.CHAT)]
@inherits MSGComponentBase

@* The chat is a drop area: a file dropped anywhere in it hangs itself on the composer, which is
   what users are used to. *@
<PathDropZone IsArea="@true" Class="inner-scrolling-context">

    @* One bar above the list and the chat, the same whether the list shows or not, so its buttons
       never move: the toggle of the list at its start, the search and the gear at its end. The gear
       opens the settings window, which lists the workspaces next to the chat. The script finds the
       toggle by its class, see watchChatList in app.js. *@
    <div class="chat-header-bar">
        @if (this.IsSidebarToggleShown)
        {
            <MudTooltip Text="@this.WorkspaceSidebarToggleTooltip" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@this.WorkspaceSidebarToggleIcon" Class="chat-list-toggle" aria-label="@this.WorkspaceSidebarToggleTooltip" OnClick="@this.ToggleWorkspaceSidebar"/>
            </MudTooltip>
        }
        @* New chat, the first row of the list, comes here while the list is out of sight, right after
           the toggle, so nothing else moves. A list which only peeks leaves it here, below the pointer
           on its way from the toggle: *@
        @if (!this.IsSidebarKept)
        {
            <NewChatButton StartNewChatRequested="@this.StartNewChatInPlace" CurrentWorkspaceId="@this.CurrentWorkspaceId" CanChooseWorkspace="@this.SettingsManager.ConfigurationData.Workspace.CanChatsGoIntoWorkspaces"/>
        }
        <div class="flex-grow-1"></div>
        @* A list which only peeks leaves the field as it is: it hides as soon as the pointer moves on to
           the field. *@
        <WorkspaceSearchField Search="@this.workspaceSearch" IsListSearched="@this.IsSidebarKept"/>
        <MudTooltip Text="@T("Show the chat options")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
            <MudIconButton Icon="@AppIcons.SETTINGS" aria-label="@T("Show the chat options")" OnClick="@this.OpenChatSettingsDialog"/>
        </MudTooltip>
    </div>

    <div class="chat-columns" @ref="this.columnsElement">
        @if (this.IsSidebarShown)
        {
            // The sidebar keeps the width the user dragged its right border to, within limits, see
            // Chat.razor.css and watchSidebarResize in app.js. Floating over the chat, it is the same
            // element, so that a click on the toggle keeps the list which peeks as it is:
            <div class="@this.SidebarClasses" style="@this.SidebarWidthStyle" @ref="this.sidebarElement">
                <InnerScrolling FillEntireHorizontalSpace="@true" Class="border border-solid rounded-lg mb-3 chat-sidebar-frame">
                    @* New chat stays at the top while the list scrolls, above the results of the search: *@
                    <HeaderContent>
                        <NewChatButton IsRow="@true" StartNewChatRequested="@this.StartNewChatInPlace" CurrentWorkspaceId="@this.CurrentWorkspaceId" CanChooseWorkspace="@this.SettingsManager.ConfigurationData.Workspace.CanChatsGoIntoWorkspaces"/>
                        <WorkspaceSearchBar Search="@this.workspaceSearch"/>
                    </HeaderContent>
                    <ChildContent>
                        <Workspaces @ref="this.workspaces" CurrentChatThread="@this.chatThread" CurrentChatThreadChanged="@this.TakeChatFromList" Search="@this.workspaceSearch" StartNewChatRequested="@this.StartNewChatInPlace" SaveState="@this.chatSaveState" SaveChatRequested="@this.SaveCurrentChat"/>
                    </ChildContent>
                </InnerScrolling>
                <div class="chat-sidebar-handle" role="separator" aria-orientation="vertical" @ref="this.sidebarHandle"></div>
            </div>
        }

        @* The open chat, beside the list or alone, below the line which starts it, see Chat.razor.css. It
           stays the same component while the list shows up or hides, so the chat keeps where the user
           scrolled to, and never loads anew. *@
        <div class="chat-column">
            <ChatComponent
                @ref="this.chatComponent"
                @bind-ChatThread="@this.chatThread"
                @bind-Provider="@this.providerSettings"
                ComposerState="@this.composerState"
                Workspaces="@this.workspaces"
                Search="@this.workspaceSearch"
                SaveState="@this.chatSaveState"
                ShowInListRequested="@this.ShowInList"/>
        </div>
    </div>
</PathDropZone>