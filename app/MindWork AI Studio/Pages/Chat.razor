@attribute [Route(Routes.CHAT)]
@using AIStudio.Settings.DataModel
@inherits MSGComponentBase

@* The chat is a drop area: a file dropped anywhere in it hangs itself on the composer, which is
   what users are used to. *@
<PathDropZone IsArea="@true" Class="inner-scrolling-context">
    
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" StretchItems="StretchItems.Start">
        <MudText Typo="Typo.h3">
            @if (this.chatThread is not null && this.chatThread.WorkspaceId != Guid.Empty)
            {
                @(T("Chat in Workspace") + $" \"{this.currentWorkspaceName}\"")
            }
            else
            {
                @T("Disappearing Chat")
            }
        </MudText>
        
        <MudToolBar WrapContent="false" Gutters="false">
            @if (this.SettingsManager.ConfigurationData.Workspace.StorageBehavior is WorkspaceStorageBehavior.DISABLE_WORKSPACES)
            {
                <MudTooltip Text="@T("Configure your workspaces")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                    <MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="@(async () => await this.OpenWorkspacesSettingsDialog())"/>
                </MudTooltip>
            }
            <MudTooltip Text="@T("Show the chat options")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@this.OpenChatSettingsDialog"/>
            </MudTooltip>
        </MudToolBar>
    </MudStack>

    <CascadingValue Value="Components.CHAT">
        <ProviderSelection @bind-ProviderSettings="@this.providerSettings" Disabled="@this.isAnswerBeingWritten"/>
    </CascadingValue>
    @if (this.AreWorkspacesVisible)
    {
        // Case: Sidebar is visible, either always or until it is hidden. It keeps the width the user
        // dragged its right border to, within limits, see Chat.razor.css and watchSidebarResize in app.js:
        <div class="chat-columns">
            <div class="chat-sidebar" style="@this.SidebarWidthStyle" @ref="this.sidebarElement">
                <InnerScrolling FillEntireHorizontalSpace="@true" Class="border border-solid rounded-lg mb-3">
                    <HeaderContent>
                        @this.RenderWorkspaceSidebarHeader(canHide: this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior is WorkspaceDisplayBehavior.TOGGLE_SIDEBAR, canClose: false)
                    </HeaderContent>
                    <ChildContent>
                        <Workspaces @ref="this.workspaces" @bind-CurrentChatThread="@this.chatThread" @bind-SearchVisible="@this.workspaceSearchVisible" StartNewChatRequested="@this.StartNewChatInWorkspace"/>
                    </ChildContent>
                </InnerScrolling>
                <div class="chat-sidebar-handle" role="separator" aria-orientation="vertical" @ref="this.sidebarHandle"></div>
            </div>
            <ChatComponent
                @ref="this.chatComponent"
                @bind-ChatThread="@this.chatThread"
                @bind-Provider="@this.providerSettings"
                IsAnswerBeingWrittenChanged="@(isBeingWritten => this.isAnswerBeingWritten = isBeingWritten)"
                ComposerState="@this.composerState"
                Workspaces="@this.workspaces"
                WorkspaceName="name => this.UpdateWorkspaceName(name)"/>
        </div>
    }
    else if (this.SettingsManager.ConfigurationData.Workspace.StorageBehavior is not WorkspaceStorageBehavior.DISABLE_WORKSPACES && this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior is WorkspaceDisplayBehavior.TOGGLE_SIDEBAR)
    {
        // Case: Sidebar can be toggled and is currently hidden
        <MudStack Row="@true" Style="width: 100%; overflow: hidden; height: 100%; flex-grow: 1; min-height: 0;">
            <MudPaper Class="border border-solid rounded-lg mb-3 d-flex">
                <MudStack Row="false" AlignItems="AlignItems.Center" StretchItems="StretchItems.Middle" Wrap="Wrap.NoWrap">
                    <MudTooltip Text="@T("Show your workspaces")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                        <MudIconButton Size="Size.Medium" Icon="@this.WorkspaceSidebarToggleIcon" OnClick="@(() => this.ToggleWorkspaceSidebar())"/>
                    </MudTooltip>
                    <MudText Typo="Typo.h6" Style="writing-mode: vertical-lr; word-spacing: 0.5em;">
                        @T("Your workspaces")
                    </MudText>
                    <MudTooltip Text="@T("Configure your workspaces")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                        <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Medium" OnClick="@(async () => await this.OpenWorkspacesSettingsDialog())"/>
                    </MudTooltip>
                </MudStack>
            </MudPaper>

            <ChatComponent
                @ref="this.chatComponent"
                @bind-ChatThread="@this.chatThread"
                @bind-Provider="@this.providerSettings"
                IsAnswerBeingWrittenChanged="@(isBeingWritten => this.isAnswerBeingWritten = isBeingWritten)"
                ComposerState="@this.composerState"
                Workspaces="@this.workspaces"
                WorkspaceName="name => this.UpdateWorkspaceName(name)"/>
        </MudStack>
    }
    else
    {
        // Case: Workspaces are disabled or shown in an overlay
        <ChatComponent
            @ref="this.chatComponent"
            @bind-ChatThread="@this.chatThread"
            @bind-Provider="@this.providerSettings"
            IsAnswerBeingWrittenChanged="@(isBeingWritten => this.isAnswerBeingWritten = isBeingWritten)"
            ComposerState="@this.composerState"
            Workspaces="@this.workspaces"
            WorkspaceName="name => this.UpdateWorkspaceName(name)"/>
    }

    @if (
        this.SettingsManager.ConfigurationData.Workspace.StorageBehavior != WorkspaceStorageBehavior.DISABLE_WORKSPACES
        && this.SettingsManager.ConfigurationData.Workspace.DisplayBehavior is WorkspaceDisplayBehavior.TOGGLE_OVERLAY)
    {
        <MudDrawer @bind-Open="@this.workspaceOverlayVisible" Width="26em" Height="100%" Anchor="Anchor.Start" Variant="DrawerVariant.Temporary" Elevation="1" Style="--workspace-list-background: var(--mud-palette-drawer-background);">
            <MudDrawerHeader Class="pa-0">
                @this.RenderWorkspaceSidebarHeader(canHide: false, canClose: true)
            </MudDrawerHeader>
            <MudDrawerContainer>
                <Workspaces @ref="this.workspaces" @bind-CurrentChatThread="@this.chatThread" @bind-SearchVisible="@this.workspaceSearchVisible" StartNewChatRequested="@this.StartNewChatInWorkspace"/>
            </MudDrawerContainer>
        </MudDrawer>
    }
</PathDropZone>

@code {
    /// <summary>
    /// The row above the workspace list, which is the same in the sidebar and in the overlay.
    /// </summary>
    /// <param name="canHide">Whether the row offers to hide the sidebar.</param>
    /// <param name="canClose">Whether the row offers to close the overlay.</param>
    private RenderFragment RenderWorkspaceSidebarHeader(bool canHide, bool canClose) => @<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Wrap="Wrap.NoWrap" Spacing="0" Class="px-1 pt-1" Style="width: 100%;">
        <MudTooltip Text="@this.WorkspaceSearchTooltip" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
            <MudIconButton Icon="@this.WorkspaceSearchIcon" Size="Size.Medium" OnClick="@this.ToggleWorkspaceSearch"/>
        </MudTooltip>
        <CompactMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Medium" AriaLabel="@T("Options for your workspaces")" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="@this.RefreshWorkspaces">
                @T("Reload your workspaces")
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="@this.OpenWorkspacesSettingsDialog">
                @T("Configure your workspaces")
            </MudMenuItem>
        </CompactMenu>
        @if (canHide)
        {
            <MudTooltip Text="@T("Hide your workspaces")" Placement="@TOOLBAR_TOOLTIP_PLACEMENT">
                <MudIconButton Icon="@this.WorkspaceSidebarToggleIcon" Size="Size.Medium" OnClick="@this.ToggleWorkspaceSidebar"/>
            </MudTooltip>
        }
        @if (canClose)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Medium" aria-label="@T("Hide your workspaces")" OnClick="@this.ToggleWorkspacesOverlay"/>
        }
    </MudStack>;
}
